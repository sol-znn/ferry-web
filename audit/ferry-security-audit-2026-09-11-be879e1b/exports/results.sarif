            "findingId": "csf_cbfdd0239239945ca02a5c31",
            "occurrenceId": "occ_b63511994b830e71124c1a44",
            "severity": "medium"
          },
          "ruleId": "atomic-swap.funded-contract-replacement",
          "ruleIndex": 0
        },
