{
  "name": "ferry-web-v2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Non-custodial cross-chain atomic swaps (BTC/ZTS/SOL) as a static site. Signing runs in WebAssembly in the page; there is no backend.",
  "scripts": {
    "wasm": "node ../scripts/build.mjs --wasm",
    "wasm:dev": "node ../scripts/build.mjs --wasm --dev",
    "build": "node ../scripts/build.mjs",
    "build:dev": "node ../scripts/build.mjs --dev",
    "dev": "npm run wasm:dev && vite",
    "preview": "vite preview --outDir ../dist",
    "preview:dev": "vite preview --outDir ../dist-dev --port 4174",
    "smoke": "node ../scripts/smoke.mjs",
    "smoke:dev": "node ../scripts/smoke.mjs --env=dev",
    "wallet:devnet": "node ../scripts/wallet-devnet.mjs",
    "wallet:provider": "node ../scripts/wallet-provider.mjs",
    "test": "cd ../wasm && go test ./... && cd ../ui && npm run wallet:provider && npm run smoke",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,vue,json,md}\"",
    "test:solana": "node --test ../scripts/solana-provider.test.mjs",
    "test:lint-config": "node --test ../scripts/lint-config.test.mjs",
    "audit:dependencies": "npm audit --omit=dev && npm audit"
  },
  "dependencies": {
    "@lucide/vue": "^1.20.0",
    "@solana/web3.js": "^1.99.0",
    "@vueuse/core": "^14.2.0",
    "nom-ui": "github:digitalSloth/nom-ui#63f755a52cf6ee3665d3755755c506e3aa191bd4",
    "tweetnacl": "^1.0.3",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/chrome": "^0.0.260",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.7.0",
    "prettier": "^3.2.0",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.3.0",
    "vite": "^7.3.7",
    "vue-tsc": "^3.3.3",
    "typescript-eslint": "^8.71.2",
    "vue-eslint-parser": "^10.4.1"
  },
  "overrides": {
    "@solana/web3.js": {
      "jayson": "5.0.0"
    }
  }
}
